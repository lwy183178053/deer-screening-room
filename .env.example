POSTGRES_DB=deerroom
POSTGRES_USER=deerroom
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEER_COMPOSE_PROJECT_NAME=deer-screening-room
DEER_GATEWAY_URL=http://gateway:8080
DEER_NODE_NAME=local-media
DEER_NODE_PUBLIC_URL=http://media-node:8081
DEER_BOOTSTRAP_ADMIN=admin@example.com
DEER_BOOTSTRAP_PASSWORD=replace-with-a-long-admin-password
DEER_NODE_API_TOKEN=replace-with-32-random-bytes
DEER_MEDIA_HOST_PATH=E:/BaiduNetdiskDownload
DEER_PASSWORD_HASH_CONCURRENCY=4
DEER_USER_STREAM_REQUESTS_PER_MINUTE=120
DEER_TURN_URLS=turn:host.docker.internal:3478?transport=udp,turn:host.docker.internal:3478?transport=tcp
DEER_STUN_URLS=stun:host.docker.internal:3478
DEER_TURN_SECRET=replace-with-a-long-random-turn-secret
DEER_TURN_TTL=2h
DEER_TURN_EXTERNAL_IP=replace-with-host-lan-ip
