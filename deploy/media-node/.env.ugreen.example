# Copy these values into the NAS Docker project's environment editor.
# DEER_MEDIA_HOST_PATH is the only path that points to a NAS-specific folder.
DEER_COMPOSE_PROJECT_NAME=deer
DEER_IMAGE=ghcr.io/lwy183178053/deer-screening-room
DEER_VERSION=latest
DEER_PULL_POLICY=missing
DEER_CONFIG_IMAGE=alpine:3.22
DEER_WIREGUARD_IMAGE=lscr.io/linuxserver/wireguard@sha256:ac43e1226878d2611315172d6ea357a95cb326ee73124b91108118efc8666889
TZ=Asia/Shanghai

DEER_NODE_NAME=replace-node-name
DEER_NODE_WIREGUARD_ADDRESS=10.77.0.2/32
DEER_GATEWAY_WIREGUARD_ADDRESS=10.77.0.1
DEER_GATEWAY_URL=http://10.77.0.1:8080
DEER_NODE_PUBLIC_URL=http://10.77.0.2:8081
DEER_CLOUD_ENDPOINT=38.34.191.104:51820
DEER_CLOUD_WIREGUARD_PUBLIC_KEY=replace-cloud-wireguard-public-key
DEER_WIREGUARD_PRIVATE_KEY=replace-node-wireguard-private-key
DEER_NODE_API_TOKEN=replace-node-api-token
DEER_RELAY_TOKEN=replace-node-relay-token

DEER_MEDIA_HOST_PATH=/CHANGE_ME
DEER_POSTER_HOST_PATH=./posters
DEER_SCAN_INTERVAL=10m
